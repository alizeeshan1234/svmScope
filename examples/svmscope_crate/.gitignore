# Rust/Anchor build output is regenerated by `anchor build` / `cargo build`.
# Only the IDL (needed to compile the Rust consumer's tests) and the compiled
# program (so the online tests run without a rebuild) are kept, below.
/target/*
!/target/idl/
!/target/deploy/
/target/deploy/*
!/target/deploy/svmscope_crate.so
/scope-test/target/
